APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Staff API bearer token lifetime (Passport personal access tokens, minutes). Default 24h.
PASSPORT_PERSONAL_ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Legacy alias accepted by config/passport.php:
# SANCTUM_EXPIRATION_MINUTES=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Payment gateway (Midtrans / Xendit / manual)
# -----------------------------------------------------------------------------
# Default provider key must match a key under config/payments.php → providers.
# Used when the POS/web client omits `provider` on POST /payment-transactions.
PAYMENT_DEFAULT_PROVIDER=xendit
# When true (default), APP_ENV=production boot fails if default provider credentials are missing.
PAYMENT_STRICT_PRODUCTION_BOOT=true

# Webhook replay protection: reject events older than this (seconds).
PAYMENT_WEBHOOK_MAX_EVENT_AGE_SECONDS=900

# Async recovery / reconciliation backoff for pending gateway transactions.
PAYMENT_RECOVERY_BACKOFF_BASE_SECONDS=15
PAYMENT_RECOVERY_BACKOFF_MAX_SECONDS=600

# Stale “pending” payment threshold (minutes) for monitoring / recovery heuristics.
PAYMENT_RECOVERY_STALE_PENDING_MINUTES=15

# Midtrans (Snap + Core API). Use sandbox keys until MIDTRANS_IS_PRODUCTION=true.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Sandbox default; production: https://app.midtrans.com/snap/v2/snap
MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/v2/snap
# HMAC / verification secret for webhooks; defaults to server key if unset.
MIDTRANS_WEBHOOK_SECRET=

# Xendit QRIS + Invoice API (direct QR for `paymentMethod=qris`; invoice fallback for others).
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
# Optional; default https://api.xendit.co
# XENDIT_API_BASE_URL=https://api.xendit.co
# Required for direct QRIS creation callback notifications.
# XENDIT_QRIS_CALLBACK_URL=https://amazingly-gully-engraved.ngrok-free.app/api/v1/payments/webhooks/xendit
# XENDIT_QRIS_EXPIRY_MINUTES=15
# XENDIT_INVOICE_DURATION_SECONDS=1800
# XENDIT_INVOICE_PAYER_EMAIL=customer@example.com
# XENDIT_INVOICE_DESCRIPTION=Restaurant order payment
# XENDIT_HTTP_TIMEOUT_SECONDS=30
# Optional JSON array of Xendit payment method codes, e.g. ["QRIS","EWALLET"]
# XENDIT_INVOICE_PAYMENT_METHODS=[]
# XENDIT_SUCCESS_REDIRECT_URL=
# XENDIT_FAILURE_REDIRECT_URL=

# Per-outlet default gateway (JSON object). Keys are outlet ids. Example:
# PAYMENT_OUTLET_GATEWAY_OVERRIDES={"1":{"default_provider":"xendit"}}
PAYMENT_OUTLET_GATEWAY_OVERRIDES={}

# Dedicated queue for payment webhook jobs (see config/queue.php).
QUEUE_PAYMENTS_WEBHOOKS=payments-webhooks

# Print dispatch mode: queue_worker | sync_dispatch | scheduled_dispatch
# Use sync_dispatch or scheduled_dispatch on shared hosting without queue:work.
PRINT_DISPATCH_MODE=queue_worker
# Batch size for print:process-pending cron command.
# PRINT_DISPATCH_BATCH_LIMIT=50

# Non-LAN print transports (Phase 5). LAN is always enabled.
# PRINT_TRANSPORT_USB_ENABLED=true
# PRINT_TRANSPORT_BLUETOOTH_ENABLED=true
# PRINT_TRANSPORT_SHARED_ENABLED=true

# Hardware bridge pairing (device credentials; no manual user token for outlets)
# HARDWARE_PAIRING_CODE_TTL_MINUTES=15
# HARDWARE_BRIDGE_ONLINE_GRACE_SECONDS=120
# HARDWARE_DEVICE_ACCESS_TOKEN_TTL_DAYS=30
# HARDWARE_DEVICE_REFRESH_TOKEN_TTL_DAYS=365

VITE_APP_NAME="${APP_NAME}"
